# OpenAI API Key (required for most features)
OPENAI_API_KEY=your_openai_api_key_here

# OpenRouter API Key (optional - for Gemini, Qwen, and other models)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# HuggingFace Token (optional - for Gemma-SEA-LION models)
HF_TOKEN=your_huggingface_token_here

# Typhoon API Key (optional - for Thai language models)
TYPHOON_API_KEY1=your_typhoon_api_key_here

# AIFT API Key (optional - for Pathumma model)
AIFT_API_KEY=your_aift_api_key_here
